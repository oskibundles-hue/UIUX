//@version=6
// =============================================================================
//  Theme Package Selector — a reusable, fully-themed indicator skeleton
// -----------------------------------------------------------------------------
//  Demonstrates a single "Theme Package" dropdown that re-colors the ENTIRE
//  indicator (candles, EMAs, bands, signals, and the info table) from one
//  cohesive, hand-tuned palette. Drop your own logic in — the theming is done.
//
//  Palettes (designed as cohesive sets, not random colors):
//    • Obsidian Sniper — tactical dark: charcoal/black base, precision neon
//      green vs. hot red, amber accent. High-contrast, "heads-up display" feel.
//    • Ice Blue        — cool & clean: glacier cyan/teal up, slate-indigo down,
//      soft sky accent on a frosted background.
//    • Royal Gold      — luxury: warm gold/amber up, deep crimson down, on a
//      near-black background with a champagne accent.
// =============================================================================

indicator("Theme Package Selector", shorttitle="THEME", overlay=true)

// ── Inputs ───────────────────────────────────────────────────────────────────
groupStyle = "🎨 Style"
groupCalc  = "📐 Calculation"

themeMode = input.string(
     "Obsidian Sniper",
     "🎨 Theme Package",
     options=["Obsidian Sniper", "Ice Blue", "Royal Gold"],
     group=groupStyle)

colorCandles = input.bool(true,  "Recolor candles",        group=groupStyle)
showBands    = input.bool(true,  "Show volatility bands",   group=groupStyle)
showTable    = input.bool(true,  "Show theme info table",   group=groupStyle)

fastLen = input.int(21,  "Fast EMA",   minval=1, group=groupCalc)
slowLen = input.int(55,  "Slow EMA",   minval=1, group=groupCalc)
atrLen  = input.int(14,  "ATR length", minval=1, group=groupCalc)
atrMult = input.float(2.0, "Band width (ATR×)", minval=0.1, step=0.1, group=groupCalc)

// ── Theme model ──────────────────────────────────────────────────────────────
// A single user-defined type holds one complete palette. One switch picks the
// active palette, and everything downstream reads from `t`.
type Theme
    string name
    color  bull       // primary up / bullish
    color  bear       // primary down / bearish
    color  accent     // highlight (signals, active EMA)
    color  neutral    // secondary lines / muted strokes
    color  bg         // table / panel background
    color  fg         // text on bg

themeObsidian() =>
    Theme.new(
         "Obsidian Sniper",
         color.rgb(0, 230, 118),     // tactical neon green
         color.rgb(255, 61, 61),     // hot red
         color.rgb(255, 191, 0),     // amber reticle accent
         color.rgb(120, 134, 140),   // gunmetal grey
         color.rgb(13, 17, 19),      // near-black charcoal
         color.rgb(224, 240, 233))   // cold white

themeIceBlue() =>
    Theme.new(
         "Ice Blue",
         color.rgb(38, 198, 218),    // glacier cyan
         color.rgb(92, 107, 192),    // slate indigo
         color.rgb(129, 212, 250),   // soft sky
         color.rgb(176, 190, 197),   // frost grey
         color.rgb(20, 33, 48),      // deep frosted navy
         color.rgb(225, 245, 254))   // ice white

themeRoyalGold() =>
    Theme.new(
         "Royal Gold",
         color.rgb(212, 175, 55),    // royal gold
         color.rgb(178, 34, 52),     // deep crimson
         color.rgb(245, 222, 179),   // champagne accent
         color.rgb(122, 110, 84),    // antique bronze
         color.rgb(17, 14, 10),      // near-black espresso
         color.rgb(245, 236, 215))   // parchment

activeTheme() =>
    switch themeMode
        "Ice Blue"   => themeIceBlue()
        "Royal Gold" => themeRoyalGold()
        => themeObsidian()

t = activeTheme()

// ── Calculations ─────────────────────────────────────────────────────────────
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
atr     = ta.atr(atrLen)

bull     = emaFast >= emaSlow
crossUp  = ta.crossover(emaFast, emaSlow)
crossDn  = ta.crossunder(emaFast, emaSlow)

trendCol = bull ? t.bull : t.bear

// ── Plots ────────────────────────────────────────────────────────────────────
// Candles
barcolor(colorCandles ? trendCol : na)

// EMAs — active (faster, trend-defining) EMA wears the accent color
pFast = plot(emaFast, "Fast EMA", color=t.accent,  linewidth=2)
pSlow = plot(emaSlow, "Slow EMA", color=t.neutral, linewidth=2)
fill(pFast, pSlow, color=color.new(trendCol, 88), title="Trend ribbon")

// Volatility bands around the slow EMA
upper = emaSlow + atr * atrMult
lower = emaSlow - atr * atrMult
uB = plot(showBands ? upper : na, "Upper band", color=color.new(t.neutral, 40))
lB = plot(showBands ? lower : na, "Lower band", color=color.new(t.neutral, 40))
fill(uB, lB, color=color.new(t.neutral, 94), title="Band fill")

// Cross signals
plotshape(crossUp ? lower : na, "Bull cross", shape.triangleup,
     location.absolute, color=t.bull, size=size.tiny)
plotshape(crossDn ? upper : na, "Bear cross", shape.triangledown,
     location.absolute, color=t.bear, size=size.tiny)

// ── Theme info table ─────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 5,
     bgcolor=t.bg, border_width=1, border_color=color.new(t.neutral, 50))

if showTable and barstate.islast
    table.cell(info, 0, 0, "🎨 " + t.name, text_color=t.fg, text_halign=text.align_left)
    table.cell(info, 1, 0, "",            bgcolor=t.bg)
    table.cell(info, 0, 1, "Bullish",  text_color=t.fg)
    table.cell(info, 1, 1, "     ",     bgcolor=t.bull)
    table.cell(info, 0, 2, "Bearish",  text_color=t.fg)
    table.cell(info, 1, 2, "     ",     bgcolor=t.bear)
    table.cell(info, 0, 3, "Accent",   text_color=t.fg)
    table.cell(info, 1, 3, "     ",     bgcolor=t.accent)
    table.cell(info, 0, 4, "Trend",    text_color=t.fg)
    table.cell(info, 1, 4, bull ? "▲ UP" : "▼ DOWN",
         text_color=t.bg, bgcolor=trendCol)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(crossUp, "Bullish EMA cross", "Fast EMA crossed above Slow EMA")
alertcondition(crossDn, "Bearish EMA cross", "Fast EMA crossed below Slow EMA")

{
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin main *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__(Higgsfield|Dropbox|Windsor_ai|vidIQ|Vertiso_Memory)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/regret_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

//@version=6
// 1-5 Adaptive S/R Strategy — 10 pip stop loss, 50 pip take profit (1:5 risk/reward).
//
// Original implementation of adaptive support/resistance zones: swing pivots are
// clustered into zones whose width adapts to volatility (ATR) and whose strength
// grows with each touch. Entries fire on a rejection (wick into a zone, close back
// outside it). This is an independent implementation of the adaptive-zone concept,
// not a copy of any third-party indicator.
//
// Alerts emit JSON payloads consumed by the companion webhook bot (trading-bot/bot).
// TradingView alert setup: create an alert on this strategy, condition
// "Order fills only", message = {{strategy.order.alert_message}}, and point the
// webhook URL at your bot's /webhook endpoint.

strategy("1-5 Adaptive S/R (10SL/50TP)",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     calc_on_every_tick = false,
     pyramiding = 0)

// ─── Inputs ──────────────────────────────────────────────────────────────────
grpZones = "Adaptive S/R Zones"
pivotLen     = input.int(10,  "Pivot length", minval = 2, group = grpZones)
atrLen       = input.int(200, "ATR length (zone width basis)", minval = 10, group = grpZones)
zoneWidthMul = input.float(0.8, "Zone width × ATR", minval = 0.1, step = 0.1, group = grpZones)
maxZones     = input.int(8,  "Max zones per side", minval = 2, maxval = 20, group = grpZones)
minTouches   = input.int(2,  "Min zone touches to trade", minval = 1, group = grpZones)

grpRisk = "1-5 Risk Model"
slPips = input.float(10.0, "Stop loss (pips)",   minval = 1, group = grpRisk)
tpPips = input.float(50.0, "Take profit (pips)", minval = 1, group = grpRisk)

grpFilter = "Filters"
useTrendFilter = input.bool(true, "EMA trend filter (longs above / shorts below)", group = grpFilter)
trendLen       = input.int(200, "Trend EMA length", minval = 10, group = grpFilter)
cooldownBars   = input.int(10, "Cooldown bars between entries", minval = 0, group = grpFilter)

grpAlert = "Webhook"
webhookSecret = input.string("CHANGE_ME", "Shared secret (must match bot WEBHOOK_SECRET)", group = grpAlert)

// ─── Pip size ────────────────────────────────────────────────────────────────
// Forex quotes use fractional pips (5/3-digit pricing), so a pip is 10 ticks.
// On non-forex symbols this still treats 10 ticks as one "pip".
pipSize = syminfo.mintick * 10

// ─── Adaptive zone state ─────────────────────────────────────────────────────
// Parallel arrays: one set for support zones, one for resistance zones.
var array<float> supCenter  = array.new_float()
var array<int>   supTouches = array.new_int()
var array<float> resCenter  = array.new_float()
var array<int>   resTouches = array.new_int()

atrVal    = ta.atr(atrLen)
zoneWidth = atrVal * zoneWidthMul
trendEma  = ta.ema(close, trendLen)

// Fold a new pivot into an existing zone when it lands inside one; otherwise
// open a new zone and evict the weakest once past the cap. Zone centers drift
// toward new pivots (weighted mean) so zones adapt as the market re-tests them.
absorbPivot(array<float> centers, array<int> touches, float price, float width, int cap) =>
    merged = false
    if array.size(centers) > 0
        for i = 0 to array.size(centers) - 1
            if math.abs(price - array.get(centers, i)) <= width
                t = array.get(touches, i)
                array.set(centers, i, (array.get(centers, i) * t + price) / (t + 1))
                array.set(touches, i, t + 1)
                merged := true
                break
    if not merged
        array.push(centers, price)
        array.push(touches, 1)
        if array.size(centers) > cap
            weakest = 0
            for i = 1 to array.size(touches) - 1
                if array.get(touches, i) < array.get(touches, weakest)
                    weakest := i
            array.remove(centers, weakest)
            array.remove(touches, weakest)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
if not na(ph)
    absorbPivot(resCenter, resTouches, ph, zoneWidth, maxZones)
if not na(pl)
    absorbPivot(supCenter, supTouches, pl, zoneWidth, maxZones)

// Nearest qualifying zone at/below (support) or at/above (resistance) price.
nearestZone(array<float> centers, array<int> touches, float px, bool below, int minT) =>
    float bestC = na
    int bestT = 0
    if array.size(centers) > 0
        for i = 0 to array.size(centers) - 1
            c = array.get(centers, i)
            t = array.get(touches, i)
            ok = t >= minT and (below ? c <= px : c >= px)
            if ok and (na(bestC) or math.abs(c - px) < math.abs(bestC - px))
                bestC := c
                bestT := t
    [bestC, bestT]

[supZ, supT] = nearestZone(supCenter, supTouches, close, true, minTouches)
[resZ, resT] = nearestZone(resCenter, resTouches, close, false, minTouches)

// ─── Signals: wick into the zone, close back outside it ─────────────────────
var int lastEntryBar = -100000
cooledDown = bar_index - lastEntryBar >= cooldownBars

longReject  = not na(supZ) and low  <= supZ + zoneWidth and close > supZ + zoneWidth and close > open
shortReject = not na(resZ) and high >= resZ - zoneWidth and close < resZ - zoneWidth and close < open

longOk  = longReject  and cooledDown and (not useTrendFilter or close > trendEma) and strategy.position_size == 0
shortOk = shortReject and cooledDown and (not useTrendFilter or close < trendEma) and strategy.position_size == 0

// ─── Orders with JSON alert payloads ─────────────────────────────────────────
buildMsg(string action, float sl, float tp, float zone, int touches) =>
    '{"secret":"' + webhookSecret + '","action":"' + action + '","symbol":"' + syminfo.ticker +
     '","price":' + str.tostring(close, format.mintick) +
     ',"sl":' + str.tostring(sl, format.mintick) +
     ',"tp":' + str.tostring(tp, format.mintick) +
     ',"zone":' + (na(zone) ? "null" : str.tostring(zone, format.mintick)) +
     ',"zone_touches":' + str.tostring(touches) +
     ',"trend":"' + (close > trendEma ? "up" : "down") +
     '","atr_pips":' + str.tostring(atrVal / pipSize, "#.#") +
     ',"time":"' + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss", "UTC") + '"}'

if longOk
    sl = close - slPips * pipSize
    tp = close + tpPips * pipSize
    lastEntryBar := bar_index
    strategy.entry("L", strategy.long, alert_message = buildMsg("buy", sl, tp, supZ, supT))
    strategy.exit("L-x", "L", stop = sl, limit = tp, alert_message = buildMsg("exit", sl, tp, supZ, supT))

if shortOk
    sl = close + slPips * pipSize
    tp = close - tpPips * pipSize
    lastEntryBar := bar_index
    strategy.entry("S", strategy.short, alert_message = buildMsg("sell", sl, tp, resZ, resT))
    strategy.exit("S-x", "S", stop = sl, limit = tp, alert_message = buildMsg("exit", sl, tp, resZ, resT))

// ─── Visuals ─────────────────────────────────────────────────────────────────
plot(trendEma, "Trend EMA", color = color.new(color.orange, 40))
plot(supZ, "Nearest support", color = color.new(color.teal, 0), style = plot.style_linebr)
plot(resZ, "Nearest resistance", color = color.new(color.red, 0), style = plot.style_linebr)
plotshape(longOk,  "Long",  shape.triangleup,   location.belowbar, color.teal, size = size.small)
plotshape(shortOk, "Short", shape.triangledown, location.abovebar, color.red,  size = size.small)

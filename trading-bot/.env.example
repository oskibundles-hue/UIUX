# Must match the "Shared secret" input in the Pine Script strategy settings.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Claude trade-filter. Leave unset to trade on raw indicator signals.
ANTHROPIC_API_KEY=
# Any Claude model id; the default is a fast/cheap model suited to per-signal filtering.
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Signals below this AI confidence (0-100) are skipped.
MIN_CONFIDENCE=60
# What to do if the Claude API call fails: reject | approve
FILTER_FAILURE_MODE=reject

# Paper-trade ledger location.
DB_PATH=paper_trades.db

{
  "name": "fd-aventador-ad",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion render of the Formula Dynamics Aventador S ad. Reads the same src/cue.json as ../build_ad.py.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "./prepare-assets.sh \"${CUE:-../cue.json}\" && remotion render src/index.ts AventadorAd \"out/$(node -p \"require('./src/cue.json').variant||'base'\").mp4\" --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell --concurrency=2",
    "prepare-assets": "./prepare-assets.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.522",
    "@remotion/layout-utils": "^4.0.522",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.522"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
